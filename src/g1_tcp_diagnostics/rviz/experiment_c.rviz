Panels:
  - Class: g1_tcp_diagnostics/CameraCPanel
    Name: Camera - Experiment C
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: C Preview - Nominal Is Not Paired
      Enabled: true
      Topic:
        Value: /g1/camera_c/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Fixed Frame: torso_link
    Frame Rate: 15
    Background Color: 32; 34; 38
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.0
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1600
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
