Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: pelvis
    - Alpha: 0.75
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: G1 Mode 6
      Update Interval: 0
      Visual Enabled: true
    - Alpha: 0.32
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Left capability score
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capability/left/score
      Use Fixed Frame: true
    - Alpha: 0.32
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Right capability score
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capability/right/score
      Use Fixed Frame: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Left optimized boundary
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.018
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capability/left/boundary
      Use Fixed Frame: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Right optimized boundary
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.018
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capability/right/boundary
      Use Fixed Frame: true
    - Alpha: 1
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.10
      Name: Left tool0
      Radius: 0.008
      Reference Frame: left_tool0
    - Alpha: 1
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.10
      Name: Right tool0
      Radius: 0.008
      Reference Frame: right_tool0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capability/query_axes
      Name: TCP query target and result
      Namespaces:
        left/achieved_tcp: true
        left/target_tcp: true
        right/achieved_tcp: true
        right/target_tcp: true
      Queue Size: 10
    - Class: rviz_default_plugins/InteractiveMarkers
      Enable Transparency: true
      Enabled: true
      Interactive Markers Namespace: /capability_tcp_targets
      Name: Interactive TCP targets
      Show Axes: false
      Show Descriptions: true
      Show Visual Aids: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: pelvis
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.05
        Y: 0.0
        Z: 0.32
      Name: Current View
      Pitch: 0.25
      Target Frame: pelvis
      Yaw: 1.57
Window Geometry:
  Height: 900
  Width: 1440
