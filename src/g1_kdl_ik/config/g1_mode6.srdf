<?xml version="1.0"?>
<robot name="g1_29dof_lock_waist_rev_1_0">
  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_tool0"/>
  </group>
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_tool0"/>
  </group>
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <end_effector name="left_tcp" parent_link="left_tool0" group="left_arm"/>
  <end_effector name="right_tcp" parent_link="right_tool0" group="right_arm"/>
</robot>
