# Weights and vendor manuals are distributed separately from source.
/third_party/g1-rh56dfx-control/recognize/pedal_center_package_v1/models/
/third_party/g1-rh56dfx-control/docs/*.pdf

# Never commit authentication or machine-local overrides.
.env
