# Recordings, RGB-D, releases and caches stay on the experiment machine.
/data/*
!/data/README.md
/calibration/*
!/calibration/*.yaml
!/calibration/README.md
/assets/workbench/preview-*.png
/assets/workbench/task/last_*_plan.json
/assets/workbench/task/left_ik_probe.json
