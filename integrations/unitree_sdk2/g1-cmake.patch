+    BUILD_RPATH "${CMAKE_SOURCE_DIR}/thirdparty/lib/${CMAKE_SYSTEM_PROCESSOR}")
+target_link_options(g1_arm_sdk_clear_weight PRIVATE "-Wl,--disable-new-dtags")
+
+# Safety-gated multi-pose right-arm payload calibration.  This intentionally
+# reuses the proven safe-probe checks in the same translation unit.
+find_package(Eigen3 REQUIRED)
+find_package(orocos_kdl REQUIRED)
+find_package(kdl_parser REQUIRED)
+add_executable(g1_right_arm_payload_calibration
+    high_level/g1_right_arm_payload_calibration.cpp)
+target_link_libraries(g1_right_arm_payload_calibration PRIVATE
+    unitree_sdk2 Eigen3::Eigen orocos-kdl kdl_parser::kdl_parser)
+set_target_properties(g1_right_arm_payload_calibration PROPERTIES
+    BUILD_RPATH "${CMAKE_SOURCE_DIR}/thirdparty/lib/${CMAKE_SYSTEM_PROCESSOR}")
+target_link_options(g1_right_arm_payload_calibration PRIVATE "-Wl,--disable-new-dtags")
+
+# Same controller and gains, selected left chain/indices; no duplicated controller.
+add_executable(g1_left_arm_payload_calibration
+    high_level/g1_right_arm_payload_calibration.cpp)
+target_compile_definitions(g1_left_arm_payload_calibration PRIVATE G1_CALIBRATION_LEFT_ARM=1)
+target_link_libraries(g1_left_arm_payload_calibration PRIVATE
+    unitree_sdk2 Eigen3::Eigen orocos-kdl kdl_parser::kdl_parser)
+set_target_properties(g1_left_arm_payload_calibration PROPERTIES
