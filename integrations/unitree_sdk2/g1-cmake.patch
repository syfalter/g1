+add_executable(g1_arm_sdk_safe_probe high_level/g1_arm_sdk_safe_probe.cpp)
+target_link_libraries(g1_arm_sdk_safe_probe unitree_sdk2)
+# Keep this safety-critical probe on SDK2's bundled CycloneDDS pair even when a
+# sourced ROS environment prepends a different libddsc to LD_LIBRARY_PATH.
+set_target_properties(g1_arm_sdk_safe_probe PROPERTIES
+    BUILD_RPATH "${CMAKE_SOURCE_DIR}/thirdparty/lib/${CMAKE_SYSTEM_PROCESSOR}")
+target_link_options(g1_arm_sdk_safe_probe PRIVATE "-Wl,--disable-new-dtags")
+
+add_executable(g1_arm_sdk_clear_weight high_level/g1_arm_sdk_clear_weight.cpp)
